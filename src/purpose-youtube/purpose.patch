 void YoutubeJob::start()
 {
-    createLocation();
+    startTray();
+}
+
+void YoutubeJob::beginUpload()
+{
+    if (!m_uploadStarted) {
+        m_uploadStarted = true;
+        createLocation();
+    }
+}
+
+void YoutubeJob::startTray()
+{
+    const QString helper = QStandardPaths::findExecutable(QStringLiteral("purpose-youtube-tray"),
+        {QDir::homePath() + QStringLiteral("/.local/libexec"), QStringLiteral(YOUTUBE_TRAY_INSTALL_DIR)});
+    if (helper.isEmpty()) {
+        qWarning() << "YouTube tray helper is not installed";
+        beginUpload();
+        return;
+    }
+    m_trayServer.setSocketOptions(QLocalServer::UserAccessOption);
+    if (!m_trayServer.listen(QStringLiteral("purpose-youtube-%1").arg(QUuid::createUuid().toString(QUuid::Id128)))) {
+        qWarning() << "Unable to create YouTube progress socket";
+        beginUpload();
+        return;
+    }
+    connect(&m_trayServer, &QLocalServer::newConnection, this, [this] {
+        m_traySocket = m_trayServer.nextPendingConnection();
+        m_traySocket->setParent(this);
+        m_trayServer.close();
+        m_traySocket->write(m_traySnapshot);
+        m_traySocket->flush();
+        connect(m_traySocket, &QLocalSocket::disconnected, m_traySocket, &QObject::deleteLater);
+        beginUpload();
+    });
+    updateTray(QStringLiteral("preparing"));
+    if (!QProcess::startDetached(helper, {QStringLiteral("--socket"), m_trayServer.fullServerName()})) {
+        qWarning() << "Unable to start YouTube progress indicator";
+        m_trayServer.close();
+        beginUpload();
+    }
+    // Let the indicator connect before an immediate upload error can destroy
+    // this job, but never make a failed tray launch block the upload.
+    QTimer::singleShot(3000, this, &YoutubeJob::beginUpload);
+}
+
+void YoutubeJob::updateTray(const QString &state, const QString &detail)
+{
+    const QJsonObject status{{QStringLiteral("state"), state},
+                             {QStringLiteral("name"), QFileInfo(m_url.path()).fileName()},
+                             {QStringLiteral("sent"), m_sent},
+                             {QStringLiteral("total"), m_total},
+                             {QStringLiteral("detail"), detail}};
+    m_traySnapshot = QJsonDocument(status).toJson(QJsonDocument::Compact) + '\n';
+    if (m_traySocket && m_traySocket->state() == QLocalSocket::ConnectedState) {
+        m_traySocket->write(m_traySnapshot);
+        m_traySocket->flush();
+    }
 }
 
