#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gsr-focused-recorder"
readonly OUTPUT_FILE="$STATE_DIR/recorder.output"
readonly PID_FILE="$STATE_DIR/recorder.pid"
readonly LAST_OUTPUT_FILE="$STATE_DIR/last-finalized.output"
readonly SESSION_FILE="$STATE_DIR/session-active"

output=""
active=false
if [[ -r "$PID_FILE" && -r "$OUTPUT_FILE" ]]; then
    recorder_pid="$(<"$PID_FILE")"
    if [[ "$recorder_pid" =~ ^[0-9]+$ && -r "/proc/$recorder_pid/cmdline" ]]; then
        command_line="$(tr '\0' ' ' <"/proc/$recorder_pid/cmdline")"
        if [[ "$command_line" == gpu-screen-recorder\ * ]]; then
            output="$(<"$OUTPUT_FILE")"
            active=true
        fi
    fi
fi

if [[ "$active" == true ]]; then
    systemctl --user stop gsr-focused-recorder.service
    rm -f -- "$SESSION_FILE"
elif [[ -r "$LAST_OUTPUT_FILE" ]]; then
    output="$(<"$LAST_OUTPUT_FILE")"
fi

if [[ -z "$output" ]]; then
    notify-send -u critical "GPU Screen Recorder" "No finalized recording is available to share"
    exit 1
fi

if [[ ! -f "$output" ]]; then
    notify-send -u critical "GPU Screen Recorder" "Recording stopped, but the output file was not found"
    exit 1
fi

if [[ "$active" == true ]]; then
    notify-send "GPU Screen Recorder" "Recording stopped; opening YouTube share dialog"
else
    notify-send "GPU Screen Recorder" "Opening the last finalized recording in YouTube share"
fi
set +e
"$HOME/.local/bin/gsr-share-youtube" "$output"
share_status=$?
set -e

# The Purpose/YouTube helper can leave Plasma with a stale tray representation
# after its dialog closes. Re-assert the idle state once the helper is gone.
qdbus-qt6 org.odin.GsrTray /Tray \
    org.odin.GsrTray.SetRecording false "" 0 >/dev/null 2>&1 || true
exit "$share_status"
